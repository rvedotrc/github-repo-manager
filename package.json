{
  "name": "github-repo-manager",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "repository": "https://github.com/rvedotrc/github-repo-manager",
  "license": "MIT",
  "author": "Rachel Evans <rachel@rachelevans.org>",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "set -ve ; pnpm run lint ; tsc",
    "build:watch": "rebuild --exclude=dist --exclude=node_modules . -- sh -c 'sleep 1 && pnpm run build'",
    "clean": "rm -rf node_modules */tsconfig.tsbuildinfo */dist */node_modules",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "rebuild src vendor codegen.ts -- pnpm run codegen",
    "lint": "set -ve ; pnpm run lint:packagejson ; prettier --write . ; eslint",
    "lint:packagejson": ": npx npm-package-json-lint -c npmpackagejsonlint.config.json .",
    "test": "echo 'Sorry :-('"
  },
  "dependencies": {
    "@blaahaj/got-to-git": "link:../../blaahaj/got-to-git",
    "@blaahaj/lazy-task": "^1.0.1",
    "graphql": "^16.14.2"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.5",
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@parcel/watcher": "^2.6.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "~9.39.5",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "globals": "^15.15.0",
    "npm-package-json-lint": "^8.0.0",
    "npm-package-json-lint-config-default": "^7.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^2.5.22",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
